{
  "name": "@molarmanful/fe-tools",
  "version": "0.0.0",
  "type": "module",
  "description": "Personal configs for my frontend toolchain.",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsdown --clean --dts",
    "dev": "pnpx @eslint/config-inspector --config eslint.config.ts",
    "lint": "eslint"
  },
  "author": "Benjamin Pang <ben@benpa.ng> (https://benpa.ng)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/molarmanful/fe-tools.git"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dprint.json",
    "dist/"
  ],
  "dependencies": {
    "globals": "^17.14.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.0",
    "eslint": "^10.15.0",
    "eslint-config-flat-gitignore": "^2.4.0",
    "eslint-flat-config-utils": "^3.2.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "eslint-plugin-regexp": "^3.3.3",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-unicorn": "^79.0.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-better-tailwindcss": {
